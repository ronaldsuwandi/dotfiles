# window navigation
cmd + alt - left : yabai -m window --focus west --wrap
cmd + alt - up : yabai -m window --focus north --wrap
cmd + alt - down : yabai -m window --focus south --wrap
cmd + alt - right : yabai -m window --focus east --wrap

# move window
cmd + alt + shift - left : yabai -m window --warp west
cmd + alt + shift - up : yabai -m window --warp north
cmd + alt + shift - down : yabai -m window --warp south
cmd + alt + shift - right : yabai -m window --warp east

# swap window
cmd + ctrl + shift - left : yabai -m window --swap west
cmd + ctrl + shift - up : yabai -m window --swap north
cmd + ctrl + shift - down : yabai -m window --swap south
cmd + ctrl + shift - right : yabai -m window --swap east

# window resize
cmd + alt + ctrl - left : yabai -m window --ratio rel:-0.05
cmd + alt + ctrl - right : yabai -m window --ratio rel:0.05
cmd + alt + ctrl - up : yabai -m window --ratio rel:-0.1
cmd + alt + ctrl - down : yabai -m window --ratio rel:0.1

# float snap (1/3 width, float-height)
# 0x21 => [
# 0x1E => ]
cmd + alt + shift - 0x21 : ~/.config/skhd/float_snap.sh left
cmd + alt + shift - 0x1E : ~/.config/skhd/float_snap.sh right

# window operations
cmd + alt + shift - space : yabai -m space --rotate 90
cmd + alt - space : yabai -m window --toggle split
cmd + alt - return : yabai -m window --toggle zoom-fullscreen && sketchybar --trigger yabai_zoom_change
cmd + alt - f : yabai -m window --toggle float; yabai -m window --grid 8:8:1:1:6:6 2>/dev/null; sketchybar --trigger yabai_zoom_change

# space layouts
cmd + alt - t : ~/.config/skhd/space_layout_toggle.sh
cmd + alt - d : yabai -m space --layout float; sketchybar --trigger yabai_layout_change
# 0x18 => equal sign
cmd + alt + ctrl - 0x18 : yabai -m space --balance
