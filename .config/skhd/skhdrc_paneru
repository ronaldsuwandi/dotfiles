# window navigation
cmd + alt - left : paneru send-cmd window focus west && sketchybar --trigger paneru_manage_change
cmd + alt - up : paneru send-cmd window focus north && sketchybar --trigger paneru_manage_change
cmd + alt - down : paneru send-cmd window focus south && sketchybar --trigger paneru_manage_change
cmd + alt - right : paneru send-cmd window focus east && sketchybar --trigger paneru_manage_change
cmd + alt + ctrl - left : paneru send-cmd window focus first && sketchybar --trigger paneru_manage_change
cmd + alt + ctrl - right : paneru send-cmd window focus last && sketchybar --trigger paneru_manage_change

# move window
cmd + alt + shift - left : paneru send-cmd window swap west && sketchybar --trigger paneru_manage_change
cmd + alt + shift - up : paneru send-cmd window swap north && sketchybar --trigger paneru_manage_change
cmd + alt + shift - down : paneru send-cmd window swap south && sketchybar --trigger paneru_manage_change
cmd + alt + shift - right : paneru send-cmd window swap east && sketchybar --trigger paneru_manage_change
cmd + ctrl + shift - left : paneru send-cmd window swap first && sketchybar --trigger paneru_manage_change
cmd + ctrl + shift - right : paneru send-cmd window swap last && sketchybar --trigger paneru_manage_change

# window resize (cycles preset_column_widths; no vertical resize in paneru)
cmd + alt + ctrl - down : paneru send-cmd window shrink
cmd + alt + ctrl - up : paneru send-cmd window grow

# window operations
cmd + alt + shift - space : paneru send-cmd window unstack
cmd + alt - space : paneru send-cmd window stack
cmd + alt - return : paneru send-cmd window fullwidth
cmd + alt - f : paneru send-cmd window manage && sketchybar --trigger paneru_manage_change
cmd + alt - c : paneru send-cmd window center

# 0x18 => equal sign
cmd + alt + ctrl - 0x18 : paneru send-cmd window equalize
