# window navigation
cmd + alt - left : paneru send-cmd window focus west && sketchybar --trigger paneru_window_focus
cmd + alt - up : paneru send-cmd window focus north && sketchybar --trigger paneru_window_focus
cmd + alt - down : paneru send-cmd window focus south && sketchybar --trigger paneru_window_focus
cmd + alt - right : paneru send-cmd window focus east && sketchybar --trigger paneru_window_focus
cmd + alt + ctrl - left : paneru send-cmd window focus first && sketchybar --trigger paneru_window_focus
cmd + alt + ctrl - right : paneru send-cmd window focus last && sketchybar --trigger paneru_window_focus

# move window
cmd + alt + shift - left : paneru send-cmd window swap west
cmd + alt + shift - up : paneru send-cmd window swap north
cmd + alt + shift - down : paneru send-cmd window swap south
cmd + alt + shift - right : paneru send-cmd window swap east
cmd + ctrl + shift - left : paneru send-cmd window swap first
cmd + ctrl + shift - right : paneru send-cmd window swap last

# window resize (cycles preset_column_widths; no vertical resize in paneru)
cmd + alt + ctrl - down : paneru send-cmd window shrink
cmd + alt + ctrl - up : paneru send-cmd window grow

# window operations
cmd + alt + shift - space : paneru send-cmd window unstack
cmd + alt - space : paneru send-cmd window stack
cmd + alt - return : paneru send-cmd window fullwidth
cmd + alt - f : paneru send-cmd window manage && sketchybar --trigger paneru_manage_change
cmd + alt - c : paneru send-cmd window center

# 0x18 => equal sign
cmd + alt + ctrl - 0x18 : paneru send-cmd window equalize
