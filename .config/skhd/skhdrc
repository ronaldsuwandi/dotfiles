# window management bindings (paneru)
.load "./skhdrc_paneru"

# switch space
ctrl - 1 : ~/.config/sketchybar/plugins/focus_space.sh 1
ctrl - 2 : ~/.config/sketchybar/plugins/focus_space.sh 2
ctrl - 3 : ~/.config/sketchybar/plugins/focus_space.sh 3
ctrl - 4 : ~/.config/sketchybar/plugins/focus_space.sh 4
ctrl - 5 : ~/.config/sketchybar/plugins/focus_space.sh 5
ctrl - 6 : ~/.config/sketchybar/plugins/focus_space.sh 6
ctrl - 7 : ~/.config/sketchybar/plugins/focus_space.sh 7
ctrl - 8 : ~/.config/sketchybar/plugins/focus_space.sh 8
ctrl - 9 : ~/.config/sketchybar/plugins/focus_space.sh 9
ctrl - 0 : ~/.config/sketchybar/plugins/focus_space.sh 10
ctrl - left : yabai -m space --focus prev
ctrl - right : yabai -m space --focus next

# move windows to space
ctrl + shift - 1 : yabai -m window --space 1 && yabai -m space --focus 1
ctrl + shift - 2 : yabai -m window --space 2 && yabai -m space --focus 2
ctrl + shift - 3 : yabai -m window --space 3 && yabai -m space --focus 3
ctrl + shift - 4 : yabai -m window --space 4 && yabai -m space --focus 4
ctrl + shift - 5 : yabai -m window --space 5 && yabai -m space --focus 5
ctrl + shift - 6 : yabai -m window --space 6 && yabai -m space --focus 6
ctrl + shift - 7 : yabai -m window --space 7 && yabai -m space --focus 7
ctrl + shift - 8 : yabai -m window --space 8 && yabai -m space --focus 8
ctrl + shift - 9 : yabai -m window --space 9 && yabai -m space --focus 9
ctrl + shift - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# menubar (move mouse to y=0)
cmd + alt - m : cliclick m:+0,0

# app shortcuts
# Finder
ctrl + shift - f : open ~

# Safari
ctrl + shift - s : osascript -e 'tell application "Safari" to make new document' -e 'tell application "Safari" to activate'

# Kitty
ctrl + shift - t : /Applications/kitty.app/Contents/MacOS/kitty --single-instance --instance-group=kitty -d ~

# Ghostty
# ctrl + shift - t : open -a "Ghostty"

# Nimble Commander
ctrl + shift - n : open -a "Nimble Commander.app"

# Google Chrome
ctrl + shift - c : open -na "Google Chrome" --args --new-window

# Disable mail shortcut in Safari
cmd - i [
	"safari"       : passthrough
]
cmd + shift - i [
	"safari"       : passthrough
]

# Disable print shortcut in Finder
cmd + shift - p [
	"finder"       : passthrough
]
cmd - p [
	"finder"       : passthrough
]

# Disable skhd on total war
.blacklist [
	"Total War: PHARAOH DYNASTIES"
]
